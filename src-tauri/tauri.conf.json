{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CardDuel",
  "version": "1.0.0",
  "identifier": "com.cardduel.app",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CardDuel",
        "width": 1200,
        "height": 840,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
